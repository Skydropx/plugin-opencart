<?xml version="1.0"?>
<ruleset name="Skydropx OpenCart Extension">
  <description>PHPCS rules for the Skydropx OpenCart 4.x extension. Style follows OpenCart core (tabs, snake_case variables).</description>

  <file>plugin-source</file>

  <arg name="extensions" value="php"/>
  <arg name="cache" value=".phpcs-cache"/>
  <arg name="colors"/>
  <arg value="sp"/>

  <!-- OpenCart 4.0.2.x requires PHP 8.0, 4.1.x requires PHP 8.1. -->
  <config name="testVersion" value="8.0-"/>
  <rule ref="PHPCompatibility"/>

  <!-- Safety and hygiene -->
  <rule ref="Generic.PHP.DisallowShortOpenTag"/>
  <rule ref="Generic.PHP.DeprecatedFunctions"/>
  <rule ref="Generic.PHP.ForbiddenFunctions">
    <properties>
      <property name="forbiddenFunctions" type="array">
        <element key="eval" value="null"/>
        <element key="var_dump" value="null"/>
        <element key="print_r" value="null"/>
        <element key="error_log" value="null"/>
        <element key="exec" value="null"/>
        <element key="shell_exec" value="null"/>
        <element key="system" value="null"/>
      </property>
    </properties>
  </rule>
  <rule ref="Generic.Files.ByteOrderMark"/>
  <rule ref="Generic.Files.LineEndings"/>
  <rule ref="Generic.WhiteSpace.DisallowSpaceIndent"/>
  <rule ref="Generic.CodeAnalysis.EmptyStatement"/>
  <rule ref="Generic.CodeAnalysis.UnconditionalIfStatement"/>
  <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter">
    <!-- Event handlers must accept OpenCart's (&$route, &$args, &$output) signature. -->
    <exclude-pattern>plugin-source/catalog/controller/event/*</exclude-pattern>
    <exclude-pattern>plugin-source/admin/controller/event/*</exclude-pattern>
  </rule>
  <rule ref="Squiz.PHP.NonExecutableCode"/>
  <rule ref="Squiz.WhiteSpace.SuperfluousWhitespace"/>
</ruleset>
